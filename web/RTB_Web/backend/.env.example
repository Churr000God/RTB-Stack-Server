PORT=3000
NODE_ENV=production

# Panel admin de gestion de buzones
# Generar el hash con:
#   node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE', 12))"
ADMIN_PASSWORD_HASH=

# Secreto para firmar la cookie de sesion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Dominio aceptado para crear cuentas y nombre del contenedor mailserver
MAIL_DOMAIN=refacrtb.com.mx
MAILSERVER_CONTAINER=mailserver
