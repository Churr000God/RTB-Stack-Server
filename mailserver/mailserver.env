ENABLE_SPAMASSASSIN=1
ENABLE_CLAMAV=1
ENABLE_FAIL2BAN=1
ENABLE_POSTGREY=0
POSTMASTER_ADDRESS=admin@refacrtb.com.mx
ONE_DIR=1
DOMAINNAME=refacrtb.com.mx
SSL_TYPE=letsencrypt
PERMIT_DOCKER=network
ENABLE_LDAP=0
ENABLE_MANAGESIEVE=1
SMTP_ONLY=0
ENABLE_POP3=1
LOG_LEVEL=info
ENABLE_QUOTA=1
POSTFIX_MESSAGE_SIZE_LIMIT=102400000

# Reenvío (SMTP relay) usando mailersend
# RELAY_HOST = relay por remitente @refacrtb.com.mx (sender_dependent_relayhost_maps)
# DEFAULT_RELAY_HOST = fallback global para remitentes sin match (bounces <>, root@),
#   para que NO intenten salida directa por el :25 (bloqueado por IONOS).
# RELAY_USER / RELAY_PASSWORD viven en mailserver.secret.env (gitignored) — ver compose env_file.
RELAY_HOST=smtp.mailersend.net
RELAY_PORT=587
DEFAULT_RELAY_HOST=[smtp.mailersend.net]:587

# Seguridad adicional
TLS_LEVEL=modern
SPOOF_PROTECTION=1
ENABLE_SRS=1
