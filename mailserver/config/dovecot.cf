# ===== LIMITE POR USUARIO/IP =====
# (Sube el número de conexiones simultáneas IMAP de un mismo usuario desde la misma IP)
mail_max_userip_connections = 50

# ===== CONCURRENCIA DE LOGIN (seguro y estable) =====
# Límite global de procesos (si tu host tiene recursos, 256 es razonable)
default_process_limit = 256

# Ajustes del servicio de login IMAP (puedes declararlo aquí)
service imap-login {
  inet_listener imap {
    # Habilita IMAP con STARTTLS como plan B si alguna red bloquea 993
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }

  # Más procesos de login disponibles
  process_limit = 256

  # Aislar conexiones (más RAM pero más robusto con clientes móviles)
  service_count = 1

  # Opcional: mantener procesos de login listos
  # process_min_avail = 10
}

# (Opcional) Más verbosidad si aún depuras clientes
# auth_verbose = yes
# mail_debug = yes
# verbose_ssl = yes
