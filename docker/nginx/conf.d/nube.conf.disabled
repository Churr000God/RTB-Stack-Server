server {
    listen 443 ssl;
    server_name nube.refacrtb.com.mx;

    ssl_certificate /etc/letsencrypt/live/nube.refacrtb.com.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nube.refacrtb.com.mx/privkey.pem;

    location / {
        proxy_pass http://nextcloud:80;
        include proxy_params;
    }
}

server {
    listen 443 ssl;
    server_name docs.refacrtb.com.mx;

    ssl_certificate /etc/letsencrypt/live/docs.refacrtb.com.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/docs.refacrtb.com.mx/privkey.pem;

    location / {
        proxy_pass http://onlyoffice:80;
        include proxy_params;
    }
}
